##################################
#### ELVEN RAINBOW BLACK HOLE ####
##################################


entity = {
	name = "elven_prismatic_black_hole_entity"
	pdxmesh = "black_hole_new_mesh"
	
	scale = 1
	default_state = "idle"
	state = { name = "idle" state_time = 5
		event = { time = 0 particle = "elven_prismatic_black_hole_particle" trigger_once = yes keep_particle = yes }
		event = { trigger_once = yes sound = { soundeffect = "blackhole_hum_idle" } }
	}
	locator = { name = "planet" }
	attach = { "planet" = "elven_prismatic_black_hole_rings_entity" }
	attach = { "planet" = "elven_prismatic_black_hole_grav_lens_entity" }
	attach = { "planet" = "elven_prismatic_black_hole_grav_animation_entity" }
	
	game_data = {
		size = 1.0
		bloom_factor = 5
	}
}

entity = { 
	name = "elven_prismatic_black_hole_rings_entity"
	pdxmesh = "black_hole_rings_mesh"
	
	default_state = "idle"
	state = { name = "idle" state_time = 5
	}
	
	## RAINBOW TEXTURES ##
	meshsettings = {
		name = "aboveShape"
		texture_diffuse = "elven_prismatic_black_hole_rings_diffuse.dds"
		#texture_normal = "nonormal.dds"
		#texture_specular = "nospec.dds"
	}
	
	## RAINBOW TEXTURES ##
	meshsettings = {
		name = "belowShape"
		texture_diffuse = "elven_prismatic_black_hole_rings_diffuse.dds"
		#texture_normal = "nonormal.dds"
		#texture_specular = "nospec.dds"
	}
	scale = 2.0
	
	game_data = {
		uv_animation_speed   = -0.025
		uv_animation_direction  = { 0.4 0.4 }
	}	
}

