###########################
### ELVEN AVARI SHIELDS ###
###########################

@Planet_Offset = -150.00

###########################
## FINAL SCALED ENTITIES ##
###########################

# Eternal Array Shields

entity = {
	name = "lhu_array_eternity_shield_entity_full"
	pdxmesh = "elven_01_empty_mesh"
	cull_radius = 250.00

	locator = { name = "center"	position = { 0 0 0 } }
	attach = { "center" = "lhu_array_eternity_shield_primary_entity_full" }

	scale = 1.0
}

