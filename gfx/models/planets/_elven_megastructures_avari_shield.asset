#####################
## SCALED ENTITIES ##
#####################

entity = {
	name = "lhu_array_eternity_shield_primary_entity_full"
	pdxmesh = "elven_great_firewall_full_mesh"
	cull_radius = 250.0

	default_state = "idle"
	state = { name = "idle" state_time = 5
		start_event = { node = root particle = "planet_shield_effect" keep_particle = yes trigger_once = yes }
	}
	
	# BLOOM FACTOR adjusts how bright the shield is in game!

	game_data = { 
		bloom_factor = 0.6 
		uv_animation_speed 		= 1
		uv_animation_direction 	= { -0.02 0.00 }
	}
	
	scale = 0.22
}

entity = {
	name = "lhu_array_eternity_shield_primary_entity_partial"
	pdxmesh = "elven_great_firewall_partial_mesh"
