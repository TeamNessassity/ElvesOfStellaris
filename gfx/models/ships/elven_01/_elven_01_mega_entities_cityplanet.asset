########################
## ELVEN CITY PLANETS ##
########################

entity = {
	name = "elven_01_city_planet_entity"
	pdxmesh = "elven_01_city_planet_mesh"
	
	default_state = "idle"
	state = { 
		name = "idle" animation = "idle" time_offset = { 0 100 } 
		start_event = { trigger_once = yes sound = { soundeffect = "amb_city_planet" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_city_planet_flyby" } }
	}

	attach = { planet = "city_planet_surface_ships_entity" }
}

################################
## SUNLESS REALMS CITY PLANET ##
################################
entity = {
	name = "elven_01_city_planet_sr_entity"
	pdxmesh = "elven_01_city_planet_sr_mesh"
	
	default_state = "idle"
	state = { 
		name = "idle" animation = "idle" time_offset = { 0 100 } 
		start_event = { trigger_once = yes sound = { soundeffect = "amb_city_planet" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_city_planet_flyby" } }
	}

	attach = { planet = "city_planet_surface_ships_entity" }
}

