		uv_animation_direction 	= { 1.0 0.0 }
	}
}

#########################
## SMALL ORBITAL SETUP ##
#########################

## NOTE: We define it here and attach it to the main frame for a spinning animation. (Cheap way to not bake the anims right into the mesh!)

entity = {
	name = "elven_02_habtiat_small_orbital_entity"
	pdxmesh = "elven_01_habitat_orbital_small_mesh"

	default_state = "idle"
	state = { name = "idle"
		start_event = { trigger_once = yes sound = { soundeffect = "space_pirate_station" } }
	}

	meshsettings = {
		name = "SmallGlowShape"
		index = 0
		texture_diffuse = "elven_02_generic_vines_diffuse.dds"
		shader = "PdxMeshAlphaAdditiveAnimateUV"
	}

	meshsettings = {
		name = "SmallOrbitalGlassShape"
		index = 0
		texture_diffuse = "elven_02_habitat_orbitals_small_glass_diffuse.dds"
		shader = "PdxMeshAlphaAdditiveAnimateUV"
	}

	meshsettings = {
		name = "VinesShape"
		index = 0
		texture_diffuse = "elven_02_habitat_orbital_vines_diffuse.dds"
		shader = "PdxMeshAlphaAdditiveAnimateUV"
	}

	game_data = {
		uv_animation_speed 		= 0.1
		uv_animation_direction 	= { 1.0 0.0 }
	}
}

