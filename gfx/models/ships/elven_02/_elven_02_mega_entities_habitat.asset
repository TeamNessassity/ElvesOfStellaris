###################
## ELVEN HABITAT ##
###################

###########################
## CENTRAL COMPLEX SETUP ##
###########################

## NOTE: The habitat was originally made 40 versions ago and as such is a rather complicated mess.
##       We use a central animated core, and then attach 4 different parts to make up the main complex.

## Habitat Spire ##
entity = {
	name = "elven_02_habitat_spire_entity"
	pdxmesh = "elven_01_habitat_spire_mesh"
	
	default_state = "idle"
	state = { name = "idle"
		start_event = { trigger_once = yes sound = { soundeffect = "space_pirate_station" } }
		event = { time = 0 node = "light_locator_01" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_locator_02" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_locator_03" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_locator_04" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
	}

	meshsettings = {
		name = "SpireVinesShape"
		index = 0
		texture_diffuse = "elven_02_habitat_vines_diffuse.dds"
		shader = "PdxMeshAlphaAdditiveAnimateUV"
	}

	game_data = {
		uv_animation_speed 		= 0.1
		uv_animation_direction 	= { 1.0 0.0 }
	}
}

## Habitat Top ##
