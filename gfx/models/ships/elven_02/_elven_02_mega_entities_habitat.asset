###########################
## HABITAT GAME ENTITIES ##
###########################

# NOTE: These are the entities Stellaris looks for to find the habitat varieties.

###################
## Small Orbital ##
###################

entity = {
	name = "elven_02_habitat_phase_01_entity"
	pdxmesh = "elven_01_habitat_frame_mesh"
	
	attach = { "TopRotation" = "elven_02_habtiat_small_orbital_entity" }
	
	## NOTE: I have no idea why we need this at all. Log is whining about it.
	locator = { name = part1 position = { 0 0 0 } }

	scale = 1.0
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 5 animation_speed = 0.2 }
	state = { name = "construction" animation = "construction" }
	
}

###################
## Large Orbital ##
###################

entity = {
	name = "elven_02_habitat_phase_02_entity"
	pdxmesh = "elven_01_habitat_frame_mesh"
	
	attach = { "TopRotation" = "elven_02_habtiat_large_orbital_entity" }
	
	## NOTE: I have no idea why we need this at all. Log is whining about it.
	locator = { name = part1 position = { 0 0 0 } }

	scale = 1.0
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 5 animation_speed = 0.2 }
	state = { name = "construction" animation = "construction" }

}

##########################
## Central Core Complex ##
##########################

entity = {
	name = "elven_02_habitat_phase_03_entity"
	
	#pdxmesh = "elven_01_habitat_spire_mesh"
	pdxmesh = "elven_01_habitat_frame_mesh"
	
	attach = { "TopRotation" = "elven_02_habitat_spire_entity" }
	attach = { "MidRotation" = "elven_02_habitat_top_entity" }
	attach = { "BottomRotation" = "elven_02_habitat_middle_entity" }
	attach = { "Tier3Rotation" = "elven_02_habitat_bottom_entity" }
	
	## NOTE: I have no idea why we need this at all. Log is whining about it.
	locator = { name = part1 position = { 0 0 0 } }

	scale = 1.0
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_blend_time = 5 animation_speed = 0.05 }
	state = { name = "construction" animation = "construction" }
	
	game_data = {
		shader_type = ship
		#emissive_recolor_crunch = 5.0
	}
 }