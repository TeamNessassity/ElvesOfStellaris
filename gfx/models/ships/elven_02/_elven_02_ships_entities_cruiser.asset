## MID ##

entity = {
	name = "elven_02_cruiser_mid_S2HB_entity"
	pdxmesh = "elven_01_lightcarrier_mesh"

	default_state = "idle"
	state = { name = "idle" state_time = 5
		event = { time = 0 node = "light_locator_01" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_locator_02" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }	
	}
	state = { name = "moving" state_time = 5
		event = { time = 0 node = "light_locator_01" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_locator_02" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "medium_engine_01" particle = "elven_01_3_0_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "medium_engine_02" particle = "elven_01_3_0_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "medium_engine_03" particle = "elven_01_2_7_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "medium_engine_04" particle = "elven_01_2_7_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "small_engine_01" particle = "elven_01_0_0_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "small_engine_02" particle = "elven_01_0_0_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		
	}
	state = { name = "death"
		event = { time = 1.00 node = "explosion_locator1" particle = "ship_burn_particle" }
		event = { time = 1.00 node = "explosion_locator1" particle = "large_ship_explosion_particle" }
		event = { time = 3.3 node = "explosion_locator2" particle = "ship_burn_particle" }
		event = { time = 3.3 node = "explosion_locator2" particle = "large_ship_explosion_particle" }
		event = { time = 4.90 node = "explosion_locator3" particle = "ship_burn_particle" }
		event = { time = 4.90 node = "explosion_locator3" particle = "large_ship_explosion_particle" }
		event = { time = 7.50 node = "explosion_locator4" particle = "ship_burn_particle" }
		event = { time = 7.50 node = "explosion_locator4" particle = "large_ship_explosion_particle" }
		event = { time = 8.90 node = "explosion_locator5" particle = "ship_burn_particle" }
		event = { time = 8.90 node = "explosion_locator5" particle = "large_ship_explosion_particle" }
		event = { time = 10.2 node = "explosion_locator6" particle = "ship_burn_particle" }
		event = { time = 10.2 node = "explosion_locator6" particle = "large_ship_explosion_particle" }
	}

	scale = 0.85

	game_data = {
		size = @lightcarrier_scale
		uv_animation_speed 		= 0.1
		uv_animation_direction 	= { -1.0 0.0 }
	}

	meshsettings = {
		name = "VinesShape"
		index = 0
		texture_diffuse = "elven_02_cruiser_vines_diffuse.dds"
		shader = "PdxMeshAlphaAdditiveAnimateUV"
	}
}

entity = {
	name = "elven_02_cruiser_mid_L1M1_entity"
	pdxmesh = "elven_01_cruiser1_mesh"
	
	locator = { name = "root" }
	
	default_state = "idle"
	state = { name = "idle" state_time = 5
		event = { time = 0 node = "light_locator_01" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_locator_02" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }	
		event = { time = 0 node = "light_locator_03" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
	}
	state = { name = "moving" state_time = 5
		event = { time = 0 node = "engine_medium_01" particle = "elven_01_2_7_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "engine_medium_02" particle = "elven_01_2_7_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "engine_large_01" particle = "elven_01_5_0_ship_exhaust_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "engine_small_01" particle = "elven_01_1_0_ship_exhaust_oblong_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "engine_small_02" particle = "elven_01_1_0_ship_exhaust_oblong_moving_particle" trigger_once = yes keep_particle = yes }
		event = { time = 0 node = "light_locator_01" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
		event = { time = 0 node = "light_locator_02" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }	
		event = { time = 0 node = "light_locator_03" particle = "elven_ship_light_viola_effect" keep_particle = yes trigger_once = yes }
	}
	state = { name = "death" chance = 1 looping = no state_time = 10
	
	}

	game_data = {
		size = @cruiser_scale
		uv_animation_speed 		= 0.1
		uv_animation_direction 	= { -1.0 0.0 }
	}

	meshsettings = {
		name = "CruiserVinesSweptShape"
		index = 0
		texture_diffuse = "elven_02_cruiser_vines_diffuse.dds"
		shader = "PdxMeshAlphaAdditiveAnimateUV"
	}
}

